---
import { detectLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  images: string[];
  altPrefix: string;
}
const { images, altPrefix } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

// A single-image product gets one full-width card instead of a two-column
// grid with an empty second cell (which used to leave the image stranded
// off-center). The inner max-w-[520px] cap keeps the bottle at the same
// visual scale either way — the card grows, the image doesn't.
const hasSingleImage = images && images.length === 1;
---

<div class:list={['grid gap-4', hasSingleImage ? 'grid-cols-1' : 'md:grid-cols-2']}>
  {images && images.length > 0 ? (
    images.map((image, index) => (
      <div class="overflow-hidden rounded-xl bg-white/50 p-4 group">
        <div class="mx-auto flex h-[420px] max-w-[520px] items-center justify-center rounded-xl overflow-hidden relative" data-zoom-container>
          <img
            src={image}
            alt={`${altPrefix} - photo ${index + 1}`}
            loading="lazy"
            class="h-full w-full max-w-full object-contain transition-transform duration-200 ease-out"
            data-zoom-img
          />
        </div>
      </div>
    ))
  ) : (
    <div class="flex h-72 items-center justify-center rounded-xl border border-dashed border-[#cbbeb3] bg-[#f8f4ee] text-sm text-[#5f6770]">
      {t.productCard.imageComingSoon}
    </div>
  )}
</div>

<script>
  if (typeof window !== 'undefined') {
    const containers = document.querySelectorAll('[data-zoom-container]');
    
    containers.forEach((container) => {
      const img = container.querySelector('[data-zoom-img]') as HTMLImageElement;
      
      container.addEventListener('mouseenter', () => {
        img.style.transform = 'scale(1.2)';
      });
      
      container.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const percentX = (x / rect.width) * 100;
        const percentY = (y / rect.height) * 100;
        
        img.style.transformOrigin = `${percentX}% ${percentY}%`;
        img.style.transform = 'scale(1.3)';
      });
      
      container.addEventListener('mouseleave', () => {
        img.style.transform = 'scale(1)';
        img.style.transformOrigin = '50% 50%';
      });
    });
  }
</script>
