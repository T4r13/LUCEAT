---
import { detectLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import type { ProductGalleryImagePresentation } from '../data/products';

interface Props {
  images: string[];
  altPrefix: string;
  sizes?: string[];
  presentationBySize?: Record<string, ProductGalleryImagePresentation>;
}
const { images, altPrefix, sizes = [], presentationBySize = {} } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

// A single-image product gets one full-width card instead of a two-column
// grid with an empty second cell (which used to leave the image stranded
// off-center). The inner max-w-[520px] cap keeps the bottle at the same
// visual scale either way — the card grows, the image doesn't.
const hasSingleImage = images && images.length === 1;
const hasCustomPresentation = Object.keys(presentationBySize).length > 0;

const getPresentation = (index: number): ProductGalleryImagePresentation =>
  presentationBySize[sizes[index]] ?? {};

const getScale = (scale?: number): number =>
  typeof scale === 'number' && Number.isFinite(scale) && scale > 0 ? scale : 1;
---

<div class:list={['grid gap-4', hasSingleImage ? 'grid-cols-1' : 'md:grid-cols-2']}>
  {images && images.length > 0 ? (
    images.map((image, index) => {
      const presentation = getPresentation(index);
      const hasImagePresentation = Boolean(presentation.scale || presentation.offsetY);
      const imageStyle = hasImagePresentation
        ? `height: calc(100% * ${getScale(presentation.scale)}); translate: 0 ${presentation.offsetY ?? '0px'};`
        : undefined;

      return (
        <div class="overflow-hidden rounded-xl bg-white/50 p-4 group">
          <div class:list={[
            'mx-auto flex h-[420px] max-w-[520px] justify-center rounded-xl overflow-hidden relative',
            hasCustomPresentation ? 'items-end' : 'items-center',
          ]} data-zoom-container>
            <img
              src={image}
              alt={`${altPrefix} - photo ${index + 1}`}
              loading="lazy"
              class:list={[
                'max-w-full object-contain transition-transform duration-200 ease-out',
                hasImagePresentation ? 'w-auto' : 'h-full w-full',
              ]}
              style={imageStyle}
              data-zoom-img
            />
          </div>
        </div>
      );
    })
  ) : (
    <div class="type-body-sm flex h-72 items-center justify-center rounded-xl border border-dashed border-[#cbbeb3] bg-[#f8f4ee] text-[#5f6770]">
      {t.productCard.imageComingSoon}
    </div>
  )}
</div>

<script>
  if (typeof window !== 'undefined') {
    const containers = document.querySelectorAll('[data-zoom-container]');
    
    containers.forEach((container) => {
      const img = container.querySelector('[data-zoom-img]') as HTMLImageElement;
      
      container.addEventListener('mouseenter', () => {
        img.style.transform = 'scale(1.2)';
      });
      
      container.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const percentX = (x / rect.width) * 100;
        const percentY = (y / rect.height) * 100;
        
        img.style.transformOrigin = `${percentX}% ${percentY}%`;
        img.style.transform = 'scale(1.3)';
      });
      
      container.addEventListener('mouseleave', () => {
        img.style.transform = 'scale(1)';
        img.style.transformOrigin = '50% 50%';
      });
    });
  }
</script>
