---
import { optimized } from '../../data/images';

// Decorative full-bleed wash. The source PNG is 1.18 MB; served as a sized
// WebP it costs a fraction of that, and it is purely cosmetic so it stays
// lazy in effect (CSS backgrounds are fetched after layout anyway).
const background = await optimized('/images/hero/bg.png', { width: 1600 });
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${background.src}')`}
></div>
