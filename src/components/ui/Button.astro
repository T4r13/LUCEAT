---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-sm px-6 py-3 text-sm font-semibold transition-colors duration-150 min-h-[44px]';
const variants = {
  primary: 'bg-brand-navy text-text-inverse hover:bg-brand-blue-dark',
  secondary: 'border border-border-brand bg-surface-white text-brand-navy hover:bg-surface-soft-blue',
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
