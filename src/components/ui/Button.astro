---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

const base =
  'type-button inline-flex min-h-[44px] items-center justify-center gap-2 rounded-sm px-6 py-3 transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.03] hover:shadow-lift active:translate-y-0 active:scale-[0.98]';
const variants = {
  primary: 'bg-brand-blue-bg text-text-inverse hover:bg-brand-navy',
  secondary: 'border border-brand-blue-bg bg-surface-white text-brand-navy hover:bg-[#eaf7fb]',
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
