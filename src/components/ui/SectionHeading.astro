---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  size?: 'section' | 'page';
  class?: string;
}
const { eyebrow, title, align = 'left', size = 'section', class: className = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
const titleSize = size === 'page' ? 'type-page-title' : 'type-section-title';
---

<div class={`${alignClass} ${className}`}>
  {eyebrow && <p class="type-label mb-3">{eyebrow}</p>}
  <h2 class={titleSize}>{title}</h2>
</div>
