---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { imageFor } from '../../data/images';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'alt'> & {
  /** Either a legacy `/images/...` path from products.ts, or an imported asset. */
  src: string | ImageMetadata;
  alt: string;
  /** Intrinsic width to emit; capped at the source width so we never upscale. */
  width?: number;
  /** Extra widths for a srcset. Requires `sizes`. */
  widths?: number[];
  sizes?: string;
  /** Modern format offered through <source>; the fallback is chosen from the source file. */
  format?: 'webp' | 'avif';
  quality?: number;
};

const {
  src,
  alt,
  width = 800,
  widths,
  sizes,
  format = 'webp',
  quality = 75,
  loading = 'lazy',
  ...attributes
} = Astro.props;

const image = typeof src === 'string' ? imageFor(src) : src;
const outputWidth = Math.min(width, image.width);
// Never ask sharp to upscale - a wider variant than the source is pure bytes.
const responsiveWidths = widths?.filter((value) => value <= image.width);
const useSrcset = Boolean(responsiveWidths?.length && sizes);

/*
 * The <img> fallback has to be a format every browser can decode, and it has to
 * match how the source is really encoded: re-encoding the one JPEG source as
 * PNG would balloon it, and flattening a transparent PNG to JPEG would paint
 * its background black. ImageMetadata.format reports the true encoding, which
 * matters here because two source files were originally misnamed .jpg.
 */
const fallbackFormat = image.format === 'jpg' || image.format === 'jpeg' ? 'jpeg' : 'png';

/*
 * <picture> would otherwise become the element the parent lays out, breaking
 * callers that position or size the <img> as a direct flex/absolute child
 * (the gallery's h-full w-full, the icon tiles' absolute inset-0).
 * display:contents removes the wrapper from layout entirely.
 */
const pictureAttributes = { style: 'display: contents' };
---

<Picture
  {...attributes}
  src={image}
  alt={alt}
  width={outputWidth}
  widths={useSrcset ? responsiveWidths : undefined}
  sizes={useSrcset ? sizes : undefined}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  formats={[format]}
  fallbackFormat={fallbackFormat}
  quality={quality}
  pictureAttributes={pictureAttributes}
/>
