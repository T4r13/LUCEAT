---
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/produits', label: 'Nos produits' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-[#e7e1db] bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center">
      <div class="rounded-full border border-[#e7e1db] bg-white/90 p-2 shadow-sm">
        <img src="/images/logo/logo-luceat.jpg" alt="Logo LUCEAT" class="h-14 w-auto max-w-[180px] object-contain sm:h-16" />
      </div>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-[#5f6770] md:flex">
      {links.map((link) => (
        <a href={link.href} class="transition hover:text-[#8ca9b8]">{link.label}</a>
      ))}
    </nav>
  </div>
</header>
