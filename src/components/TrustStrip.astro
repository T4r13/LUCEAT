---
import TrustCard from './ui/TrustCard.astro';
import Icon from './ui/Icon.astro';
import { detectLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

// Only claims verified against source material are rendered.
// "Expertise dermo-cosmétique" — from LUCEAT's own legal/brand statement.
// "Fabriqué en Tunisie" — from the flyer's Ariana, Tunisie address.
//
// TODO (confirm before enabling): "Testé dermatologiquement" and
// "Contrôle pédiatrique" — do not render until verified with LUCEAT.

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-12 gap-y-4 border-t border-border-subtle px-4 py-6 sm:px-6 lg:px-8" data-reveal>
  <TrustCard label={t.trust.expertise}>
    <Icon slot="icon" name="microscope" size={20} />
  </TrustCard>
  <TrustCard label={t.trust.madeInTunisia}>
    <Icon slot="icon" name="map-pin" size={20} />
  </TrustCard>
</div>
