---
import { site } from '../data/site.ts';
import Icon from './ui/Icon.astro';
import BotanicalLineArt from './decorations/BotanicalLineArt.astro';
import { detectLocale, path } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

const links = [
  { href: path('home', locale), label: t.nav.home },
  { href: path('products', locale), label: t.nav.products },
  { href: path('about', locale), label: t.nav.about },
  { href: path('contact', locale), label: t.nav.contact },
];

const partnerLogos = Array.from({ length: 8 }, (_, index) => `/images/nos%20partenaires/p${index + 1}.png`);
const partnerNames = ['Medigros', 'Cotupha', 'Distrimed', 'Medika', 'Sopropha', 'Paragros', 'Best Para', 'Médicaments Okba'];
---

<footer class="relative isolate overflow-hidden border-t border-[#007fc6] bg-[#007fc6]">
  <BotanicalLineArt variant="leaves" class="absolute -bottom-32 -right-28 h-80 w-80 opacity-[0.1] sm:-right-12 sm:h-[440px] sm:w-[440px]" />
  <div class="relative z-10 mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div>
      <div class="w-full">
        <div class="mb-0">
          <h3 class="text-lg font-semibold uppercase tracking-[0.2em] text-white">{t.footer.partnersHeading}</h3>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" data-partners-previous aria-label={t.footer.previousPartners} class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-[#007fc6]/80 text-xl text-white transition hover:bg-white hover:text-[#007fc6]">&#8592;</button>
          <div data-partners-carousel class="flex min-w-0 flex-1 snap-x snap-mandatory gap-0 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {partnerLogos.map((logo, index) => (
              <div class="shrink-0 snap-start basis-1/2 text-center">
                <div class="flex h-64 items-center justify-center">
                  <img src={logo} alt={`${t.footer.partnerAlt}: ${partnerNames[index]}`} class="-translate-y-8 scale-110 max-h-full max-w-full object-contain" loading="lazy" />
                </div>
                <p class="-mt-16 text-sm font-semibold text-white">{partnerNames[index]}</p>
              </div>
            ))}
          </div>
          <button type="button" data-partners-next aria-label={t.footer.nextPartners} class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-[#007fc6]/80 text-xl text-white transition hover:bg-white hover:text-[#007fc6]">&#8594;</button>
        </div>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-white/75">{t.footer.navHeading}</h3>
      <ul class="mt-4 space-y-2 text-sm text-white/90">
        {links.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-white/70">{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-white/75">{t.footer.contactHeading}</h3>
      <ul class="mt-2 text-sm text-white/90">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-[44px] items-center gap-2 transition-colors hover:text-white/70"
            aria-label={t.contact.emailAria(site.email)}
          >
            <Icon name="mail" size={18} class="shrink-0" />
            {site.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.phone.href}`}
            class="flex min-h-[44px] items-center gap-2 transition-colors hover:text-white/70"
            aria-label={t.contact.phoneAria(site.phone.display)}
          >
            <Icon name="phone" size={18} class="shrink-0" />
            {site.phone.display}
          </a>
        </li>
        <li class="flex items-start gap-2 py-1">
          <Icon name="map-pin" size={18} class="mt-0.5 shrink-0" />
          <span>{site.address.formatted}</span>
        </li>
      </ul>
      <a
        href={site.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.contact.facebookAria}
        class="mt-3 flex min-h-[44px] w-fit items-center gap-2 text-sm text-white/90 transition-colors hover:text-white/70"
      >
        <Icon name="facebook" size={18} class="shrink-0" />
        Facebook
      </a>
    </div>
  </div>
</footer>

<script>
  const partnersCarousel = document.querySelector<HTMLElement>('[data-partners-carousel]');
  const previousPartners = document.querySelector<HTMLButtonElement>('[data-partners-previous]');
  const nextPartners = document.querySelector<HTMLButtonElement>('[data-partners-next]');

  const movePartners = (direction: number) => {
    partnersCarousel?.scrollBy({ left: partnersCarousel.clientWidth * direction, behavior: 'smooth' });
  };

  const advancePartners = () => {
    if (!partnersCarousel) return;

    const atEnd = partnersCarousel.scrollLeft + partnersCarousel.clientWidth >= partnersCarousel.scrollWidth - 2;
    if (atEnd) {
      partnersCarousel.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      movePartners(1);
    }
  };

  let partnerAutoplay = window.setInterval(advancePartners, 6000);
  const resetPartnerAutoplay = () => {
    window.clearInterval(partnerAutoplay);
    partnerAutoplay = window.setInterval(advancePartners, 6000);
  };

  previousPartners?.addEventListener('click', () => {
    movePartners(-1);
    resetPartnerAutoplay();
  });
  nextPartners?.addEventListener('click', () => {
    movePartners(1);
    resetPartnerAutoplay();
  });
</script>
