---
import { site } from '../data/site.ts';
import Icon from './ui/Icon.astro';
import { detectLocale, path } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

const links = [
  { href: path('home', locale), label: t.nav.home },
  { href: path('products', locale), label: t.nav.products },
  { href: path('about', locale), label: t.nav.about },
  { href: path('contact', locale), label: t.nav.contact },
];
---

<footer class="border-t border-[#e7e1db] bg-[#f8f4ee]">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div>
      <img src="/images/logo/logo-luceat.jpg" alt="Logo LUCEAT" class="h-12 w-auto" />
      <p class="mt-4 max-w-sm text-sm leading-7 text-[#5f6770]">
        {t.footer.brandBlurb}
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-[#5f6770]">{t.footer.navHeading}</h3>
      <ul class="mt-4 space-y-2 text-sm text-[#5f6770]">
        {links.map((link) => (
          <li><a href={link.href} class="hover:text-[#8ca9b8]">{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-[#5f6770]">{t.footer.contactHeading}</h3>
      <ul class="mt-2 text-sm text-[#5f6770]">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-[44px] items-center gap-2 hover:text-[#8ca9b8]"
            aria-label={t.contact.emailAria(site.email)}
          >
            <Icon name="mail" size={18} class="shrink-0" />
            {site.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.phone.href}`}
            class="flex min-h-[44px] items-center gap-2 hover:text-[#8ca9b8]"
            aria-label={t.contact.phoneAria(site.phone.display)}
          >
            <Icon name="phone" size={18} class="shrink-0" />
            {site.phone.display}
          </a>
        </li>
        <li class="flex items-start gap-2 py-1">
          <Icon name="map-pin" size={18} class="mt-0.5 shrink-0" />
          <span>{site.address.formatted}</span>
        </li>
      </ul>
      <a
        href={site.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.contact.facebookAria}
        class="mt-3 flex min-h-[44px] w-fit items-center gap-2 text-sm text-[#5f6770] hover:text-[#8ca9b8]"
      >
        <Icon name="facebook" size={18} class="shrink-0" />
        Facebook
      </a>
    </div>
  </div>
</footer>
