---
import { site } from '../data/site.ts';
import Icon from './ui/Icon.astro';
import OptimizedImage from './ui/OptimizedImage.astro';
import BotanicalLineArt from './decorations/BotanicalLineArt.astro';
import { detectLocale, path } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

const links = [
  { href: path('home', locale), label: t.nav.home },
  { href: path('products', locale), label: t.nav.products },
  { href: path('about', locale), label: t.nav.about },
  { href: path('contact', locale), label: t.nav.contact },
];

const partnerLogos = Array.from({ length: 8 }, (_, index) => `/images/nos%20partenaires/p${index + 1}.png`);
const partnerNames = ['Medigros', 'Cotupha', 'Distrimed', 'Medika', 'Sopropha', 'Paragros', 'Best Para', 'Médicaments Okba'];
const partnerPages = Array.from({ length: Math.ceil(partnerLogos.length / 2) }, (_, page) => [
  { logo: partnerLogos[page * 2], name: partnerNames[page * 2] },
  partnerLogos[page * 2 + 1] ? { logo: partnerLogos[page * 2 + 1], name: partnerNames[page * 2 + 1] } : null,
]);

interface Props {
  /**
   * Set when the page already shows LUCEAT® in a more prominent spot (the
   * homepage hero logo, the about-page h1). The mark belongs on the first
   * prominent mention per page, not on every occurrence.
   */
  brandMarkShown?: boolean;
}
const { brandMarkShown = false } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden border-t border-brand-navy bg-brand-navy">
  <BotanicalLineArt variant="leaves" class="absolute -bottom-32 -right-28 h-80 w-80 opacity-[0.1] sm:-right-12 sm:h-[440px] sm:w-[440px]" />
  <BotanicalLineArt variant="flower" class="absolute -left-24 -top-24 hidden h-72 w-72 opacity-[0.07] lg:block" />

  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8 lg:pt-16">
    <div class="grid gap-y-12 gap-x-8 md:grid-cols-2 md:gap-x-10 lg:grid-cols-[1.7fr_1fr_2fr] lg:gap-x-12">
      <!-- Partners -->
      <div class="min-w-0 md:col-span-2 lg:col-span-1">
        <div class="mb-6 flex flex-col items-center text-center lg:items-start lg:text-left">
          <h2 class="type-footer-heading">{t.footer.partnersHeading}</h2>
          <span class="mt-2 block h-0.5 w-8 rounded-full bg-[#9CCFE5]" aria-hidden="true"></span>
        </div>

        <div class="mx-auto max-w-md lg:mx-0" data-partners-root role="group" aria-roledescription="carousel" aria-label={t.footer.partnersCarousel}>
          <div class="flex items-center justify-center gap-3">
            <button
              type="button"
              data-partners-previous
              aria-label={t.footer.previousPartners}
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/25 text-white/80 transition hover:border-white hover:bg-white hover:text-brand-navy focus-visible:border-white"
            >
              <Icon name="chevron-left" size={16} />
            </button>

            <div
              data-partners-carousel
              class="flex min-w-0 flex-1 snap-x snap-mandatory gap-0 overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            >
              {partnerPages.map((pair) => (
                <div class="flex w-full shrink-0 snap-start justify-center gap-4">
                  {pair.map((partner) =>
                    partner ? (
                      <div class="flex w-[7.5rem] flex-col items-center gap-2.5 sm:w-36">
                        <div class="flex h-24 w-full items-center justify-center rounded-xl border border-black/5 bg-white p-3 shadow-[0_8px_20px_-6px_rgba(4,26,44,0.35)] sm:h-28 sm:p-4">
                          <OptimizedImage
                            src={partner.logo}
                            alt={`${t.footer.partnerAlt}: ${partner.name}`}
                            class="max-h-full max-w-full object-contain"
                            width={240}
                          />
                        </div>
                        <p class="type-caption text-center font-medium text-white/90">{partner.name}</p>
                      </div>
                    ) : (
                      <div class="w-[7.5rem] sm:w-36" aria-hidden="true" />
                    )
                  )}
                </div>
              ))}
            </div>

            <button
              type="button"
              data-partners-next
              aria-label={t.footer.nextPartners}
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/25 text-white/80 transition hover:border-white hover:bg-white hover:text-brand-navy focus-visible:border-white"
            >
              <Icon name="chevron-right" size={16} />
            </button>
          </div>

          <div class="mt-2 flex items-center justify-center gap-1">
            <div data-partners-dots class="flex items-center justify-center">
              {partnerPages.map((_, index) => (
                <button
                  type="button"
                  data-partners-dot
                  aria-label={t.footer.goToPartnerPage(index + 1)}
                  aria-current={index === 0 ? 'true' : undefined}
                  class="flex h-11 w-11 items-center justify-center rounded-full"
                >
                  {/* 44x44 hit area; the visible dot stays small. */}
                  <span
                    data-partners-dot-mark
                    aria-hidden="true"
                    class="h-1.5 w-1.5 rounded-full bg-white/35 transition-all"
                  />
                </button>
              ))}
            </div>
            <button
              type="button"
              data-partners-toggle
              aria-label={t.footer.pausePartners}
              data-label-pause={t.footer.pausePartners}
              data-label-resume={t.footer.resumePartners}
              aria-pressed="false"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white/80 transition hover:text-white focus-visible:text-white"
            >
              <span data-partners-toggle-icon><Icon name="pause" size={16} /></span>
              <span data-partners-toggle-icon-play hidden><Icon name="play" size={16} /></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="min-w-0 lg:border-l lg:border-white/15 lg:pl-12">
        <div class="mb-5">
          <h2 class="type-footer-heading">{t.footer.navHeading}</h2>
          <span class="mt-2 block h-0.5 w-8 rounded-full bg-[#9CCFE5]" aria-hidden="true"></span>
        </div>
        <ul class="type-body-sm space-y-3 text-white/85">
          {links.map((link) => (
            <li>
              <a href={link.href} class="group inline-flex items-center gap-1.5 transition-colors hover:text-white focus-visible:text-white">
                {link.label}
                <Icon name="chevron-right" size={14} class="shrink-0 opacity-0 transition-all -translate-x-1 group-hover:translate-x-0 group-hover:opacity-70" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="min-w-0 md:border-l md:border-white/15 md:pl-8 lg:pl-12">
        <div class="mb-5">
          <h2 class="type-footer-heading">{t.footer.contactHeading}</h2>
          <span class="mt-2 block h-0.5 w-8 rounded-full bg-[#9CCFE5]" aria-hidden="true"></span>
        </div>
        <ul class="type-body-sm space-y-3 text-white/90">
          <li>
            <a
              href={`mailto:${site.email}`}
              class="flex items-center gap-3 transition-colors hover:text-white"
              aria-label={t.contact.emailAria(site.email)}
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10">
                <Icon name="mail" size={16} class="shrink-0" />
              </span>
              {site.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10">
              <Icon name="phone" size={16} class="shrink-0" />
            </span>
            <span class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-2">
              {site.phones.map((phone, index) => (
                <>
                  {index > 0 && <span class="text-white/45" aria-hidden="true">/</span>}
                  <a
                    href={`tel:${phone.href}`}
                    class="transition-colors hover:text-white"
                    aria-label={t.contact.phoneAria(phone.display)}
                  >
                    {phone.display}
                  </a>
                </>
              ))}
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10">
              <Icon name="map-pin" size={16} class="shrink-0" />
            </span>
            <span class="pt-2">{site.address.formatted[locale]}</span>
          </li>
          <li>
            <a
              href={site.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t.contact.facebookAria}
              class="flex items-center gap-3 transition-colors hover:text-white"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10">
                <Icon name="facebook" size={16} class="shrink-0" />
              </span>
              Facebook
            </a>
          </li>
          <li>
            <a
              href={site.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t.contact.instagramAria}
              class="flex items-center gap-3 transition-colors hover:text-white"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10">
                <Icon name="instagram" size={16} class="shrink-0" />
              </span>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-10 border-t border-white/10 lg:mt-12">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      <p class="type-caption text-center text-white/75">
        &copy; {currentYear} {site.name}{brandMarkShown ? '' : '®'}. {t.footer.rightsReserved}
      </p>
    </div>
  </div>
</footer>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-partners-root]').forEach((root) => {
    const carousel = root.querySelector<HTMLElement>('[data-partners-carousel]');
    const previousBtn = root.querySelector<HTMLButtonElement>('[data-partners-previous]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-partners-next]');
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-partners-toggle]');
    const pauseIcon = root.querySelector<HTMLElement>('[data-partners-toggle-icon]');
    const playIcon = root.querySelector<HTMLElement>('[data-partners-toggle-icon-play]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-partners-dot]'));
    if (!carousel) return;

    const pageCount = dots.length || 1;

    const setActiveDot = (index: number) => {
      dots.forEach((dot, i) => {
        const active = i === index;
        // aria-current is what actually exposes the active slide; the classes
        // below only style the 6px mark inside the 44x44 hit area.
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');

        const mark = dot.querySelector<HTMLElement>('[data-partners-dot-mark]');
        mark?.classList.toggle('bg-white', active);
        mark?.classList.toggle('w-4', active);
        mark?.classList.toggle('bg-white/35', !active);
        mark?.classList.toggle('w-1.5', !active);
      });
    };

    const currentPage = () => Math.round(carousel.scrollLeft / carousel.clientWidth);

    const goToPage = (index: number) => {
      const clamped = ((index % pageCount) + pageCount) % pageCount;
      carousel.scrollTo({
        left: clamped * carousel.clientWidth,
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    };

    const movePage = (direction: number) => goToPage(currentPage() + direction);

    // "paused" is the user's explicit choice and outranks hover/focus pausing,
    // which is transient. Reduced motion means autoplay never starts at all.
    let paused = reducedMotion.matches || pageCount <= 1;
    let autoplay: number | undefined;

    const stopAutoplay = () => {
      window.clearInterval(autoplay);
      autoplay = undefined;
    };

    const startAutoplay = () => {
      if (paused) return;
      stopAutoplay();
      autoplay = window.setInterval(() => movePage(1), 6000);
    };

    const syncToggle = () => {
      if (!toggleBtn) return;
      const label = paused
        ? toggleBtn.dataset.labelResume ?? ''
        : toggleBtn.dataset.labelPause ?? '';
      toggleBtn.setAttribute('aria-label', label);
      toggleBtn.setAttribute('aria-pressed', String(paused));
      pauseIcon?.toggleAttribute('hidden', paused);
      playIcon?.toggleAttribute('hidden', !paused);
    };

    toggleBtn?.addEventListener('click', () => {
      paused = !paused;
      if (paused) stopAutoplay();
      else startAutoplay();
      syncToggle();
    });

    // A newly expressed reduced-motion preference should stop a running
    // slideshow, not wait for a reload.
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) {
        paused = true;
        stopAutoplay();
      }
      syncToggle();
    });

    previousBtn?.addEventListener('click', () => { movePage(-1); startAutoplay(); });
    nextBtn?.addEventListener('click', () => { movePage(1); startAutoplay(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { goToPage(index); startAutoplay(); }));

    carousel.addEventListener('scroll', () => setActiveDot(currentPage()), { passive: true });
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    setActiveDot(0);
    syncToggle();
    startAutoplay();
  });
</script>
