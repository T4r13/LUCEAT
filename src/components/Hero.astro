---
import Button from './ui/Button.astro';
import OptimizedImage from './ui/OptimizedImage.astro';
import BotanicalLineArt from './decorations/BotanicalLineArt.astro';
import { detectLocale, path } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { optimized } from '../data/images';

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

// The hero band cross-fades between four 1366x236 photos. Resolve every frame
// at build time so the client swaps between optimized WebPs rather than the
// original PNGs, and hand the list to the script through a data attribute
// (an inline define:vars block would need its own CSP hash on every page).
const heroSlides = await Promise.all(
  ['/images/hero/x1.png', '/images/hero/x2.png', '/images/hero/x3.png', '/images/hero/x4.png'].map(
    (src) => optimized(src, { width: 1366 }),
  ),
);
const [firstSlide] = heroSlides;
---

<section class="relative isolate overflow-hidden bg-transparent">
  <BotanicalLineArt variant="flower" class="absolute -bottom-28 -left-28 h-[360px] w-[360px] opacity-[0.1] sm:-bottom-20 sm:-left-16 sm:h-[460px] sm:w-[460px]" />
  <div class="mx-auto max-w-[1440px] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <OptimizedImage
      src="/images/logo/logo-luceat.jpg"
      alt={t.hero.logoAlt}
      class="mb-0 h-36 w-auto object-contain sm:h-44 lg:ml-16"
      width={560}
      loading="eager"
      fetchpriority="high"
    />
    <div class="relative overflow-hidden shadow-lift" data-reveal style="width: 100vw; margin-left: calc(50% - 50vw);">
      <img
        src={firstSlide.src}
        alt={t.hero.imageAlt}
        class="h-[250px] w-full object-cover opacity-70 transition-transform duration-700 ease-out sm:h-[300px] lg:h-auto"
        data-hero-slideshow
        data-hero-slides={JSON.stringify(heroSlides.map((slide) => slide.src))}
        width={firstSlide.width}
        height={firstSlide.height}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <div aria-hidden="true" class="absolute inset-y-0 left-0 w-1/2 bg-brand-navy/70"></div>
      <div class="absolute inset-y-0 left-0 flex w-1/2 items-center px-6 sm:px-10 lg:px-16">
        <h1 class="type-display text-white">
          {t.hero.title}
        </h1>
      </div>
    </div>
    <div class="relative px-2 pt-8 sm:px-6 lg:px-16" data-reveal style="--reveal-delay: 140ms">
      <p class="type-subtitle max-w-md">
        {t.hero.subtitle}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href={path('products', locale)} variant="primary">{t.buttons.discoverProducts}</Button>
        <Button href={path('about', locale)} variant="secondary">{t.buttons.ourExpertise}</Button>
      </div>
    </div>
  </div>
</section>

<script>
  const heroImage = document.querySelector<HTMLImageElement>('[data-hero-slideshow]');
  const heroImages: string[] = JSON.parse(heroImage?.dataset.heroSlides ?? '[]');

  if (heroImage && heroImages.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroImages.slice(1).forEach((src) => {
      const image = new Image();
      image.src = src;
    });

    let currentImage = 0;
    window.setInterval(() => {
      currentImage = (currentImage + 1) % heroImages.length;
      heroImage.classList.add('translate-x-full');
      heroImage.src = heroImages[currentImage];
      window.requestAnimationFrame(() => {
        heroImage.classList.remove('translate-x-full');
      });
    }, 4000);
  }
</script>
