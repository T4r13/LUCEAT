---
import Button from './ui/Button.astro';
import { detectLocale, path } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<section class="bg-surface-ivory">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:px-8 lg:py-24">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-blue">{t.hero.eyebrow}</p>
      <h1 class="mt-5 text-hero font-display font-medium text-brand-navy">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-md text-body-lg text-text-body">
        {t.hero.subtitle}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href={path('products', locale)} variant="primary">{t.buttons.discoverProducts}</Button>
        <Button href={path('about', locale)} variant="secondary">{t.buttons.ourExpertise}</Button>
      </div>
    </div>
    <div class="overflow-hidden rounded-lg shadow-lift">
      <img
        src="/images/hero/acceuil-refined.jpg"
        alt={t.hero.imageAlt}
        class="h-[420px] w-full object-cover object-[75%_35%] sm:h-[480px] lg:h-[520px]"
        width="1800"
        height="1012"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
