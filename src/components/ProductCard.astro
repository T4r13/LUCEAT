---
import { detectLocale, productPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { getProductContent } from '../i18n/product';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
const content = getProductContent(product, locale);
const href = productPath(product.slug, locale);
---

<a href={href} class="group block overflow-hidden rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-white via-white to-[#f0fafe] shadow-[0_8px_24px_-6px_rgba(12,47,69,0.08)] transition-all duration-500 hover:border-brand-blue/40 hover:shadow-[0_24px_48px_-12px_rgba(21,151,199,0.25)] hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:ring-offset-2" data-reveal>
  <div class="relative overflow-hidden rounded-t-2xl bg-gradient-to-br from-[#f0fafe] via-[#f5fbfd] to-[#f8fbfd] p-3">
    {/* Decorative gradient overlay */}
    <div class="absolute inset-0 bg-gradient-to-br from-[#e8f7fc]/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    
    <div class="relative mx-auto flex h-[340px] max-w-[340px] items-center justify-center rounded-xl bg-gradient-to-b from-white/60 to-[#fafbfc]/40 overflow-hidden">
      {/* Subtle background pattern */}
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-0 right-0 w-40 h-40 bg-brand-blue/5 rounded-full blur-2xl -mr-20 -mt-20"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-cyan-300/5 rounded-full blur-2xl -ml-16 -mb-16"></div>
      </div>

      {product.images?.[0] ? (
        <img
          src={product.images[0]}
          alt={content.name}
          loading="lazy"
          class="relative z-10 h-full w-full max-w-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
        />
      ) : (
        <div class="relative z-10 flex h-full w-full items-center justify-center rounded-lg border-2 border-dashed border-[#b9dce7]/50 text-center text-sm text-text-body">
          {t.productCard.imageComingSoon}
        </div>
      )}
    </div>
  </div>
  
  <div class="relative bg-gradient-to-b from-white to-[#f8fbfd] px-6 py-5 border-t border-brand-blue/10 overflow-hidden" style="background-image: url('/images/hero/tlogo.png'); background-size: 280px; background-position: bottom right; background-repeat: no-repeat; background-attachment: scroll;">
    {/* Semi-transparent overlay to ensure text readability */}
    <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-white/75 to-[#f8fbfd]/70"></div>

    {/* Top border gradient */}
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-brand-blue/20 to-transparent"></div>
    
    <h3 class="relative z-10 text-lg font-semibold text-brand-navy leading-snug line-clamp-2 transition-colors duration-300 group-hover:text-brand-blue">
      {content.name}
    </h3>
    <p class="relative z-10 mt-2 text-sm leading-6 text-text-body/80 line-clamp-2 transition-colors duration-300 group-hover:text-text-body">
      {content.shortDescription}
    </p>
    
    {/* Blue bottom accent bar */}
    <div class="relative z-10 mt-4 h-1.5 w-0 bg-gradient-to-r from-brand-blue via-cyan-400 to-brand-blue rounded-full transition-all duration-500 group-hover:w-16 shadow-[0_4px_12px_-4px_rgba(21,151,199,0.4)]"></div>
  </div>
</a>

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-2px);
    }
  }
  
  :global(.js) a[data-reveal] {
    animation: float 3s ease-in-out infinite;
    animation-delay: var(--reveal-delay, 0ms);
  }
  
  a:hover {
    animation: none !important;
  }
</style>
