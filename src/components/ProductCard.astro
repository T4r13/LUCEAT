---
const { product } = Astro.props;
---

<a href={`/produits/${product.slug}`} class="group block overflow-hidden rounded-[1.5rem] border border-[#e7e1db] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#8ca9b8]">
  <div class="overflow-hidden rounded-t-[1.5rem] bg-[#fcfaf7] p-4">
    <div class="mx-auto flex h-[360px] max-w-[360px] items-center justify-center rounded-[1.5rem] bg-white shadow-[0_20px_40px_-20px_rgba(0,0,0,0.12)]">
      <img
        src={product.images?.[0] || '/images/products/placeholder.jpg'}
        alt={product.name}
        loading="lazy"
        class="h-full w-full max-w-full object-contain"
      />
    </div>
  </div>
  <div class="p-6">
    <h3 class="text-xl font-semibold text-[#4d4a47]">{product.name}</h3>
    <p class="mt-3 text-sm leading-7 text-[#5f6770]">{product.shortDescription}</p>
  </div>
</a>
