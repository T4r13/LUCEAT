---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import IntroSection from '../../components/IntroSection.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/ui/Icon.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import { products } from '../../data/products';
import { useTranslations } from '../../i18n/ui';
import { path } from '../../i18n/routes';

const locale = 'en' as const;
const t = useTranslations(locale);
const featuredProducts = products.filter((product) => product.featured);

// Pending review (see src/i18n/translations — dermatological explanation,
// not yet reviewed for accurate English translation). Shown in French with
// a visible notice rather than an invented translation.
const introParagraphsFr = [
  'La peau de bébé est une peau fragile qui n\'a pas achevé encore sa maturité. Les glandes sudorales et sébacées des nourrissons sont encore immatures et ne remplissent pas encore parfaitement toutes leurs fonctions. À terme, elles permettent la formation d\'un film hydrolipidique protecteur (à base de sueur et sébum) qui maintient la neutralité du pH de la peau, permet de lutter contre le développement de micro-organismes et de réguler la thermogénèse de l\'organisme.',
  'Les bébés sont particulièrement sensibles au chaud et au froid, et sont d\'une façon générale très mal protégés contre les agressions du monde extérieur. Enfin, la flore cutanée, qui constitue une barrière naturelle contre les infections, se met en place progressivement à condition de ne pas être détruite par des agents lavants et antibactériens agressifs.',
  'En attendant cette maturité, il vaut mieux choisir pour eux des produits cosmétiques hypoallergéniques, doux dans leur composition et respectant l\'équilibre hydrolipidique et l\'hydratation de leur peau — c\'est le principal objectif sur lequel a travaillé l\'équipe du laboratoire LUCEAT. D\'autre part, le bain de bébé est certes une mesure d\'hygiène incontournable, mais LUCEAT en crée un véritable moment de plaisir et de communication entre mère et bébé, qui se sent heureux et confiant.',
  'LUCEAT propose une gamme complète de soins conçus spécialement pour le confort et le bien-être de vos bébés.',
];

const features = [
  { ...t.why.cards.sensitiveSkin, icon: 'shield-check' },
  { ...t.why.cards.gentleHygiene, icon: 'droplets' },
  { ...t.why.cards.labExpertise, icon: 'flask-conical' },
  { ...t.why.cards.skinBalance, icon: 'scale' },
] as const;
---

<BaseLayout
  title="LUCEAT – Gentle care for babies and children"
  description="Discover LUCEAT, a laboratory specialising in gentle cosmetic care for babies and children."
>
  <Hero />
  <TrustStrip />

  <IntroSection title={t.philosophy.heading} eyebrow={t.philosophy.eyebrow} text={introParagraphsFr} pendingNotice={t.philosophy.pendingNotice} />

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-16">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">{t.featured.eyebrow}</p>
        <h2 class="mt-2 text-3xl font-semibold text-[#4d4a47]">{t.featured.heading}</h2>
      </div>
      <a href={path('products', locale)} class="text-sm font-semibold text-[#8ca9b8] hover:text-[#7695a3]">{t.buttons.seeAllProducts}</a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="rounded-[2rem] bg-[#f8f4ee] p-8 sm:p-10 lg:p-14">
      <div class="mb-10 max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">{t.why.eyebrow}</p>
        <h2 class="mt-2 text-3xl font-semibold text-[#4d4a47]">{t.why.heading}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {features.map((feature) => (
          <div class="rounded-[1.25rem] border border-border-subtle bg-surface-white p-6">
            <IconBadge size="lg">
              <Icon name={feature.icon} size={26} />
            </IconBadge>
            <h3 class="mt-4 text-lg font-semibold text-text-primary">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-text-body">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] bg-[#eef6f2] p-8 text-center sm:p-10 lg:p-14">
      <h2 class="text-3xl font-semibold text-[#4d4a47]">{t.adviceCta.heading}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-[#5f6770]">
        {t.adviceCta.text}
      </p>
      <a href={path('contact', locale)} class="mt-8 inline-flex rounded-full bg-[#8ca9b8] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#7695a3]">
        {t.buttons.contactUs}
      </a>
    </div>
  </section>
</BaseLayout>
