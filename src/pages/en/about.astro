---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout title="About – LUCEAT" description="Discover the LUCEAT laboratory and its philosophy of gentle care for babies and children.">
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <h1 class="text-4xl font-semibold text-[#4d4a47] sm:text-5xl">{t.about.heading}</h1>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">
          {t.about.intro}
        </p>
      </div>
      <div class="rounded-xl border border-[#e7e1db] bg-white p-8 shadow-sm">
        <p class="text-lg leading-8 text-[#5f6770]">
          A baby’s skin is naturally more fragile. That is why every formulation is designed to be gentle, hypoallergenic and respectful of the protective hydrolipidic film.
        </p>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">
          The LUCEAT laboratory places attentive listening, safety and simplicity at the heart of its care, to bring moments of well-being into the home.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
