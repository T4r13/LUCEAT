---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { useTranslations } from '../../i18n/ui';
import { path } from '../../i18n/routes';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout title="Our products – LUCEAT" description="Discover the LUCEAT range of care for babies and children.">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">{t.productsPage.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-semibold text-[#4d4a47] sm:text-5xl">{t.productsPage.heading}</h1>
      <p class="mt-6 text-lg leading-8 text-[#5f6770]">
        {t.productsPage.supporting}
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
    <div class="mt-12 text-center">
      <a href={path('home', locale)} class="inline-flex rounded-full border border-[#d7cfc5] bg-white px-6 py-3 text-sm font-semibold text-[#4d4a47] transition hover:border-[#8ca9b8]">
        {t.buttons.backToHome}
      </a>
    </div>
  </section>
</BaseLayout>
