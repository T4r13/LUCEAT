---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../data/site.ts';
import { useTranslations } from '../../i18n/ui';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout title="Contact – LUCEAT" description="Get in touch with LUCEAT for advice or information about its care for babies and children.">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1 class="text-4xl font-semibold text-[#4d4a47] sm:text-5xl">{t.contact.heading}</h1>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">
          {t.contact.intro}
        </p>
        <div class="mt-8 space-y-1 rounded-xl border border-[#e7e1db] bg-white p-8 shadow-sm">
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
            aria-label={t.contact.emailAria(site.email)}
          >
            <Icon name="mail" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.emailLabel}</span> {site.email}</span>
          </a>
          <a
            href={`tel:${site.phone.href}`}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
            aria-label={t.contact.phoneAria(site.phone.display)}
          >
            <Icon name="phone" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.phoneLabel}</span> {site.phone.display}</span>
          </a>
          <div class="flex items-start gap-3 py-2 text-[#5f6770]">
            <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-[#4d4a47]" />
            <p>
              <span class="font-semibold text-[#4d4a47]">{t.contact.addressLabel}</span><br />
              {site.address.street}<br />
              {site.address.postalCode} {site.address.city}<br />
              {site.address.governorate}, {site.address.country}
            </p>
          </div>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.contact.facebookAria}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
          >
            <Icon name="facebook" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.facebookLabel}</span> LUCEAT</span>
          </a>
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.contact.instagramAria}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
          >
            <Icon name="instagram" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.instagramLabel}</span> LUCEAT</span>
          </a>
        </div>
      </div>

      <div class="min-h-[320px] overflow-hidden rounded-xl sm:min-h-[420px] lg:min-h-[480px]">
        <iframe
          src={site.mapsEmbedUrl}
          title={t.contact.ourAddress}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-full min-h-[320px] w-full border-0 sm:min-h-[420px] lg:min-h-[480px]"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
