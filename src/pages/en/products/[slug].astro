---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import { products } from '../../../data/products';
import { getProductContent } from '../../../i18n/product';
import { useTranslations } from '../../../i18n/ui';
import { path } from '../../../i18n/routes';

export async function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const locale = 'en' as const;
const t = useTranslations(locale);
const content = getProductContent(product, locale);
---

<BaseLayout title={`${content.name} – LUCEAT`} description={content.shortDescription}>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href={path('products', locale)} class="inline-flex items-center gap-2 rounded-full border border-[#d7cfc5] bg-white px-4 py-2 text-sm font-semibold text-[#4d4a47] transition hover:bg-[#f8f4ee] hover:text-[#8ca9b8]">
        ← {t.buttons.backToProducts}
      </a>
    </div>
    {content.isPending && (
      <p class="mb-8 rounded-[0.75rem] border border-dashed border-[#cbbeb3] bg-[#f8f4ee] px-4 py-3 text-sm text-[#5f6770]">
        {t.productDetail.pendingNotice}
      </p>
    )}
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">{t.productDetail.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-semibold text-[#4d4a47] sm:text-5xl">{content.name}</h1>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">{content.description}</p>
        <div class="mt-8">
          <ProductGallery images={product.images} altPrefix={content.name} />
        </div>
      </div>
      <div class="space-y-8">
        <div class="rounded-[1.5rem] border border-[#e7e1db] bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.productDetail.keyPoints}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-7 text-[#5f6770]">
            {(content.benefits || []).map((point) => <li class="flex gap-3"><span class="text-[#8ca9b8]">•</span><span>{point}</span></li>)}
          </ul>
        </div>
        <div class="rounded-[1.5rem] border border-[#e7e1db] bg-[#f8f4ee] p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.productDetail.usage}</h2>
          <p class="mt-4 text-sm leading-7 text-[#5f6770]">{content.usage}</p>
        </div>
        <div class="rounded-[1.5rem] border border-[#e7e1db] bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.productDetail.ingredients}</h2>
          <p class="mt-4 text-sm leading-7 text-[#5f6770]">{product.ingredients}</p>
        </div>
        {content.precautions && (
          <div class="rounded-[1.5rem] border border-[#e7e1db] bg-white p-8 shadow-sm">
            <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.productDetail.precautions}</h2>
            <p class="mt-4 text-sm leading-7 text-[#5f6770]">{content.precautions}</p>
          </div>
        )}
        <div class="rounded-[1.5rem] border border-[#e7e1db] bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.productDetail.availableSizes}</h2>
          <p class="mt-4 text-sm leading-7 text-[#5f6770]">{product.sizes?.length ? t.productDetail.sizesAvailable(product.sizes) : t.productDetail.sizesComingSoon}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
