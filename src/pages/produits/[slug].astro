---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import Icon from '../../components/ui/Icon.astro';
import { products } from '../../data/products';
import { getProductContent } from '../../i18n/product';
import { useTranslations } from '../../i18n/ui';
import { path } from '../../i18n/routes';

export async function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const locale = 'fr' as const;
const t = useTranslations(locale);
const content = getProductContent(product, locale);
---

<BaseLayout title={`${content.name} – LUCEAT`} description={content.shortDescription}>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href={path('products', locale)} class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-white px-4 py-2 text-sm font-semibold text-text-primary transition hover:bg-surface-ivory hover:text-brand-blue">
        ← {t.buttons.backToProducts}
      </a>
    </div>
    
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-8">
        <div>
          <h1 class="text-4xl font-semibold text-brand-blue sm:text-5xl">{content.name}</h1>
          <p class="mt-6 text-lg leading-8 text-text-body">{content.description}</p>
        </div>

        {/* Benefits section - 3 columns */}
        <div class="grid gap-6 grid-cols-3">
          <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-white to-surface-ivory p-8 shadow-sm hover:shadow-lg hover:border-brand-blue/40 transition-all duration-300 group">
            <div class="absolute inset-0 opacity-20">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="w-full h-full object-cover" />
            </div>
            <div class="relative z-10 flex flex-col items-center gap-4 text-center">
              <div class="p-3 rounded-full bg-brand-blue/10 group-hover:bg-brand-blue/20 transition-colors">
                <Icon name="droplets" size={32} class="text-brand-blue" />
              </div>
              <span class="font-semibold text-text-primary text-base">Nettoie en douceur</span>
            </div>
          </div>
          <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-white to-surface-ivory p-8 shadow-sm hover:shadow-lg hover:border-brand-blue/40 transition-all duration-300 group">
            <div class="absolute inset-0 opacity-20">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="w-full h-full object-cover" />
            </div>
            <div class="relative z-10 flex flex-col items-center gap-4 text-center">
              <div class="p-3 rounded-full bg-brand-blue/10 group-hover:bg-brand-blue/20 transition-colors">
                <Icon name="flask-conical" size={32} class="text-brand-blue" />
              </div>
              <span class="font-semibold text-text-primary text-base">Hydratant</span>
            </div>
          </div>
          <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-white to-surface-ivory p-8 shadow-sm hover:shadow-lg hover:border-brand-blue/40 transition-all duration-300 group">
            <div class="absolute inset-0 opacity-20">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="w-full h-full object-cover" />
            </div>
            <div class="relative z-10 flex flex-col items-center gap-4 text-center">
              <div class="p-3 rounded-full bg-brand-blue/10 group-hover:bg-brand-blue/20 transition-colors">
                <Icon name="scale" size={32} class="text-brand-blue" />
              </div>
              <span class="font-semibold text-text-primary text-base">Demelant</span>
            </div>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-surface-ivory via-white to-white p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="relative z-10">
            <div class="mb-4 flex items-center gap-3">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="h-12 w-12 object-contain opacity-80" />
              <h2 class="text-2xl font-semibold text-brand-blue">{t.productDetail.usage}</h2>
            </div>
            <p class="mt-4 text-sm leading-7 text-text-body">{content.usage}</p>
          </div>
        </div>
      </div>
      <div
        class="space-y-8"
        style={product.slug === 'eau-de-senteur' ? 'transform: translateX(4.5rem); transition: transform 0.2s ease;' : undefined}
      >
        <ProductGallery
          images={product.images}
          altPrefix={content.name}
          alignRight={product.slug === 'eau-de-senteur'}
        />
        <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-white p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="relative z-10">
            <div class="mb-4 flex items-center gap-3">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="h-12 w-12 object-contain opacity-80" />
              <h2 class="text-2xl font-semibold text-brand-blue">{t.productDetail.ingredients}</h2>
            </div>
            <p class="mt-4 text-sm leading-7 text-text-body">{product.ingredients}</p>
          </div>
        </div>
        {content.precautions && (
          <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-white p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="relative z-10">
              <div class="mb-4 flex items-center gap-3">
                <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="h-12 w-12 object-contain opacity-80" />
                <h2 class="text-2xl font-semibold text-brand-blue">{t.productDetail.precautions}</h2>
              </div>
              <p class="mt-4 text-sm leading-7 text-text-body">{content.precautions}</p>
            </div>
          </div>
        )}
        <div class="relative overflow-hidden rounded-2xl border border-brand-blue/20 bg-white p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="relative z-10">
            <div class="mb-4 flex items-center gap-3">
              <img src="/images/hero/tlogo.png" alt="" aria-hidden="true" class="h-12 w-12 object-contain opacity-80" />
              <h2 class="text-2xl font-semibold text-brand-blue">{t.productDetail.availableSizes}</h2>
            </div>
            <p class="mt-4 text-sm leading-7 text-text-body">{product.sizes?.length ? t.productDetail.sizesAvailable(product.sizes) : t.productDetail.sizesComingSoon}</p>
          </div>
        </div>
    </div>
  </section>
</BaseLayout>
