---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../data/site.ts';
import { useTranslations } from '../i18n/ui';

const locale = 'fr' as const;
const t = useTranslations(locale);
---

<BaseLayout title="Contact – LUCEAT" description="Contactez LUCEAT pour des conseils ou des informations sur ses soins pour bébé et enfant.">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">{t.contact.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-semibold text-[#4d4a47] sm:text-5xl">{t.contact.heading}</h1>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">
          {t.contact.intro}
        </p>
        <div class="mt-8 space-y-1 rounded-xl border border-[#e7e1db] bg-white p-8 shadow-sm">
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
            aria-label={t.contact.emailAria(site.email)}
          >
            <Icon name="mail" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.emailLabel}</span> {site.email}</span>
          </a>
          <a
            href={`tel:${site.phone.href}`}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
            aria-label={t.contact.phoneAria(site.phone.display)}
          >
            <Icon name="phone" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.phoneLabel}</span> {site.phone.display}</span>
          </a>
          <div class="flex items-start gap-3 py-2 text-[#5f6770]">
            <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-[#4d4a47]" />
            <p>
              <span class="font-semibold text-[#4d4a47]">{t.contact.addressLabel}</span><br />
              {site.address.street}<br />
              {site.address.postalCode} {site.address.city}<br />
              {site.address.governorate}, {site.address.country}
            </p>
          </div>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.contact.facebookAria}
            class="flex min-h-[44px] items-center gap-3 text-[#5f6770] hover:text-[#8ca9b8]"
          >
            <Icon name="facebook" size={20} class="shrink-0 text-[#4d4a47]" />
            <span><span class="font-semibold text-[#4d4a47]">{t.contact.facebookLabel}</span> LUCEAT</span>
          </a>
        </div>
      </div>

      <div class="rounded-xl border border-[#e7e1db] bg-[#f8f4ee] p-8 shadow-sm">
        <h2 class="text-2xl font-semibold text-[#4d4a47]">{t.contact.ourAddress}</h2>
        <p class="mt-4 text-[#5f6770]">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}<br />
          {site.address.governorate}, {site.address.country}
        </p>
        <a
          href={site.mapsSearchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-[#8ca9b8] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#7695a3]"
        >
          {t.buttons.viewOnGoogleMaps}
          <Icon name="external-link" size={16} class="shrink-0" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
