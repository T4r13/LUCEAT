---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact – LUCEAT" description="Contactez LUCEAT pour des conseils ou des informations sur ses soins pour bébé et enfant.">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8ca9b8]">Contact</p>
        <h1 class="mt-4 text-4xl font-semibold text-[#4d4a47] sm:text-5xl">Nous sommes à votre écoute</h1>
        <p class="mt-6 text-lg leading-8 text-[#5f6770]">
          Pour toute demande d’information ou de conseil, vous pouvez nous contacter directement via nos coordonnées ci-dessous.
        </p>
        <div class="mt-8 space-y-4 rounded-[1.5rem] border border-[#e7e1db] bg-white p-8 shadow-sm">
          <p><span class="font-semibold text-[#4d4a47]">Adresse :</span> 18 rue des Lilas, 75016 Paris</p>
          <p><span class="font-semibold text-[#4d4a47]">Téléphone :</span> +33 1 00 00 00 00</p>
          <p><span class="font-semibold text-[#4d4a47]">Email :</span> contact@luceat.fr</p>
          <p><span class="font-semibold text-[#4d4a47]">Facebook :</span> <a href="https://www.facebook.com" target="_blank" rel="noreferrer" class="text-[#8ca9b8] hover:text-[#7695a3]">facebook.com/luceat</a></p>
        </div>
      </div>

      <div class="rounded-[2rem] border border-[#e7e1db] bg-[#f8f4ee] p-8 shadow-sm">
        <h2 class="text-2xl font-semibold text-[#4d4a47]">Notre adresse</h2>
        <div class="mt-6 overflow-hidden rounded-[1.5rem] bg-white p-2 shadow-sm">
          <iframe
            title="Carte de l'adresse LUCEAT"
            src="https://www.google.com/maps?q=18+rue+des+Lilas+Paris&z=15&output=embed"
            class="h-96 w-full rounded-[1.25rem]"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
