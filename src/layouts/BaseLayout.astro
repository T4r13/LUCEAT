---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LuceatPageBackground from '../components/decorations/LuceatPageBackground.astro';
import { canonicalPath, detectLocale, getAlternateUrl } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { optimized } from '../data/images';

interface Props {
  title: string;
  description: string;
  is404?: boolean;
}
const { title, description, is404 = false } = Astro.props;

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

const ogLocale = locale === 'fr' ? 'fr_TN' : 'en_TN';
const canonicalUrl = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const frAlternate = new URL(getAlternateUrl(Astro.url.pathname, 'fr'), Astro.site);
const enAlternate = new URL(getAlternateUrl(Astro.url.pathname, 'en'), Astro.site);
// Social scrapers are least surprising with PNG, and the logo has real
// transparency that a JPEG would flatten to black.
const ogSource = await optimized('/images/logo/logo-luceat.jpg', { width: 1200, format: 'png' });
const ogImage = new URL(ogSource.src, Astro.site);
const favicon = await optimized('/images/hero/tlogo.png', { width: 64, format: 'png' });
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B2C4F" />
    {!is404 && <>
      <link rel="canonical" href={canonicalUrl} />
      <link rel="alternate" hreflang="fr" href={frAlternate} />
      <link rel="alternate" hreflang="en" href={enAlternate} />
      <link rel="alternate" hreflang="x-default" href={frAlternate} />
    </>}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!is404 && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogSource.width)} />
    <meta property="og:image:height" content={String(ogSource.height)} />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>
    <Navbar />
    <main id="main" class="relative isolate min-h-screen overflow-hidden">
      <LuceatPageBackground />
      <slot />
    </main>
    <Footer />
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver((entries, activeObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              activeObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -36px' });
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
